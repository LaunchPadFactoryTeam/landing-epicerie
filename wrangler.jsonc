{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "landing-epicerie",
	"main": "src/worker.js",
	"compatibility_date": "2026-05-06",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		// URLs propres sans slash final (ex. /epiceries, /epiceries/traceo).
		// Cloudflare sert public/epiceries/index.html sur /epiceries et redirige
		// /epiceries/ → /epiceries. Évite la boucle de redirection 307↔301.
		"html_handling": "drop-trailing-slash"
	},
	"build": {
		"command": "bash build.sh"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	// --- D1 : leads + downloads ---
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "launchpad-leads",
			"database_id": "4cbcf4f9-e184-49db-bd5f-da67cc62ceb2"
		}
	],
	// --- R2 : PDF privés ---
	"r2_buckets": [
		{
			"binding": "PDFS",
			"bucket_name": "launchpad-guides"
		}
	],
	// --- Variables non sensibles (notifs email contact) ---
	// Les secrets (BREVO_API_KEY, TURNSTILE_SECRET, SIGNING_KEY) restent gérés
	// via `wrangler pages secret put` ou le dashboard (Variables and Secrets).
	"vars": {
		"NOTIFY_TO_EMAIL": "launchpadfactory.contact@gmail.com",
		"NOTIFY_FROM_EMAIL": "launchpadfactory.contact@gmail.com",
		"NOTIFY_FROM_NAME": "LaunchPad — Site"
	}
	// SIGNING_KEY est un secret défini via :
	//   wrangler pages secret put SIGNING_KEY --project-name landing-epicerie
	//
	// Secrets liés au formulaire /api/contact :
	//   wrangler pages secret put BREVO_API_KEY     --project-name landing-epicerie
	//   wrangler pages secret put TURNSTILE_SECRET  --project-name landing-epicerie  (optionnel)
}